# udev rule of the IR Transceiver Utility, installed by CMakeLists.txt.
#
# Gives the logged-in user access to supported ELK Smart USB IR dongles
# (vendor 045c; products 0132, 0195, 0184, 0134). The 70- prefix sorts before
# 73-seat-late.rules, which applies the uaccess tag.
SUBSYSTEM=="usb", ATTR{idVendor}=="045c", ATTR{idProduct}=="0132", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="045c", ATTR{idProduct}=="0195", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="045c", ATTR{idProduct}=="0184", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="045c", ATTR{idProduct}=="0134", TAG+="uaccess"
